// The schema of docs/frameworks/prisma.md, generated by scripts/check-docs-examples.mjs.
generator client {
  provider = "prisma-client"
  output   = "../.docs-check/generated/prisma"
  // The example runs with Node type stripping: generated imports name their .ts files.
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    Int    @id
  email String
}
