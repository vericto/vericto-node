{
  "name": "@vericto/sdk",
  "version": "0.5.0",
  "description": "Official Vericto SDK for Node.js: database guardrails for AI agents, check SQL before it runs. Wrappers for snowflake-sdk and better-sqlite3, SQL tools for the Vercel AI SDK, the OpenAI Agents SDK, Mastra and LangChain.js, and a client for the Vericto Runtime API.",
  "license": "Apache-2.0",
  "author": "Vericto <security@vericto.com>",
  "homepage": "https://vericto.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vericto/vericto-node.git"
  },
  "bugs": "https://github.com/vericto/vericto-node/issues",
  "keywords": [
    "sql",
    "firewall",
    "security",
    "guardrails",
    "database-guardrails",
    "ai-guardrails",
    "snowflake",
    "sqlite",
    "better-sqlite3",
    "ai-agents",
    "langchain",
    "vercel-ai-sdk",
    "openai-agents",
    "mastra",
    "vericto"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./better-sqlite3": {
      "import": {
        "types": "./dist/better-sqlite3.d.ts",
        "default": "./dist/better-sqlite3.js"
      },
      "require": {
        "types": "./dist/better-sqlite3.d.cts",
        "default": "./dist/better-sqlite3.cjs"
      }
    },
    "./snowflake": {
      "import": {
        "types": "./dist/snowflake.d.ts",
        "default": "./dist/snowflake.js"
      },
      "require": {
        "types": "./dist/snowflake.d.cts",
        "default": "./dist/snowflake.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/openai-agents.d.ts",
        "default": "./dist/openai-agents.js"
      },
      "require": {
        "types": "./dist/openai-agents.d.cts",
        "default": "./dist/openai-agents.cjs"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/mastra.d.ts",
        "default": "./dist/mastra.js"
      },
      "require": {
        "types": "./dist/mastra.d.cts",
        "default": "./dist/mastra.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude 'test/live/**'",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "tsup --silent",
    "docs:check": "node scripts/check-docs-examples.mjs core"
  },
  "peerDependencies": {
    "@langchain/classic": ">=1.0.0 <2",
    "@langchain/core": ">=1.0.0 <2",
    "@mastra/core": ">=1.0.0 <2",
    "@openai/agents": ">=0.18.0 <1",
    "@vericto/vericto-cli": ">=2.1.0 <3",
    "ai": ">=7.0.0 <8",
    "better-sqlite3": ">=9",
    "snowflake-sdk": ">=1.9",
    "typeorm": ">=0.3.20"
  },
  "peerDependenciesMeta": {
    "@langchain/classic": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@vericto/vericto-cli": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "snowflake-sdk": {
      "optional": true
    },
    "typeorm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@langchain/classic": "1.0.57",
    "@langchain/core": "1.3.1",
    "@mastra/core": "1.81.0",
    "@openai/agents": "0.21.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "7.0.159",
    "better-sqlite3": "13.0.3",
    "eslint": "10.13.0",
    "tsup": "9.0.0",
    "typeorm": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "typeorm": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
